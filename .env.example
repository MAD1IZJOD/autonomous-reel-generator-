# Autonomous Reel Generator - environment variable contract
#
# This file documents configuration names and safe defaults. It must never
# contain real credentials. Copy it to .env for local development and fill
# values from your secret manager. .env is ignored by Git.
#
# Nothing here is wired to application code yet: the application does not
# exist in the foundation phase. Names are provisional until the Milestone 2
# implementation lands, and changes must be reflected in the deployment docs.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
APP_ENV=development                 # development | staging | production
APP_BASE_URL=http://localhost:8000
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=info                      # debug | info | warn | error
WORKER_ROLE=cpu                     # cpu | render | gpu | qc

# ---------------------------------------------------------------------------
# Metadata database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://arg:arg@localhost:5432/arg
DATABASE_POOL_SIZE=10
DATABASE_STATEMENT_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Object storage (S3-compatible: MinIO locally, S3/R2 in cloud)
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=arg-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL_SECONDS=900

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
AUTH_SECRET=                         # required outside development; generate a random value
SESSION_TTL_SECONDS=28800
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Orchestration
# ---------------------------------------------------------------------------
JOB_LEASE_SECONDS=120
JOB_HEARTBEAT_SECONDS=30
JOB_MAX_ATTEMPTS=3
STAGE_TIMEOUT_SECONDS=7200
GPU_IDLE_SHUTDOWN_SECONDS=600       # founder's observed 5-10 minute target window
GPU_SESSION_MAX_SECONDS=14400
WORKER_CONCURRENCY=2
QUEUE_POLL_INTERVAL_MS=1000

# ---------------------------------------------------------------------------
# Provider credentials and endpoints
# ---------------------------------------------------------------------------
# Premium providers remain the quality baseline where measured; see
# docs/ai/MODEL_REGISTRY.md. Do not enable a provider for private media until
# the data-processing policy permits it.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_v4       # verify the current provider identifier before use
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
RUNPOD_API_KEY=
RUNPOD_TERMINATE_AFTER_IDLE=true
COMFYUI_BASE_URL=
COMFYUI_API_KEY=

# ---------------------------------------------------------------------------
# Model routing and safety
# ---------------------------------------------------------------------------
ALLOW_EXTERNAL_PROVIDER_DATA=false  # must be explicitly enabled per workspace/provider
ENABLE_PAID_FALLBACKS=false         # opt-in; fallbacks must preserve quality floors
LICENSE_ALLOWLIST_STRICT=true       # block models whose commercial status is unverified
DEFAULT_QUALITY_PROFILE=baseline    # baseline | draft | high
MAX_CANDIDATES_PER_SHOT=2           # founder's editorial rule: review at most two scored options

# ---------------------------------------------------------------------------
# Cost controls
# ---------------------------------------------------------------------------
DAILY_GPU_BUDGET_USD=
MONTHLY_GPU_BUDGET_USD=
COST_ALERT_THRESHOLD_PERCENT=80
REQUIRE_COST_APPROVAL_ABOVE_USD=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=autonomous-reel-generator
METRICS_ENABLED=true
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Retention (defaults are provisional; see docs/infrastructure/DATA_RETENTION.md)
# ---------------------------------------------------------------------------
SOURCE_MEDIA_RETENTION_DAYS=
GENERATED_MEDIA_RETENTION_DAYS=
LOG_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365
